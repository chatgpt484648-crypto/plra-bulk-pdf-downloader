{
  "manifest_version": 3,
  "name": "PLRA Bulk PDF Downloader",
  "version": "2.0",
  "action": {
    "default_popup": "popup.html"
  },
  "background": {
    "service_worker": "background.js"
  },
  "permissions": [
    "activeTab",
    "downloads",
    "scripting",
    "tabs"
  ],
  "host_permissions": [
    "https://eregistration.punjab-zameen.gov.pk/*"
  ],
  "content_scripts": [
    {
      "matches": [
        "https://eregistration.punjab-zameen.gov.pk/*"
      ],
      "js": [
        "content.js"
      ],
      "run_at": "document_idle"
    }
  ]
}
